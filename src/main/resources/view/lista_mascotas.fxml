<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.tec.bd.crv.controller.ListaMascotasController"
            styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="10" left="24"/>
            </padding>
            <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="2.0">
                <Label text="Lista de mascotas" styleClass="brand-title"/>
                <Label text="Tabla general conectada a Oracle" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Nuevo registro" onAction="#abrirRegistro" styleClass="secondary-button"/>
            <Button text="Volver al menu" onAction="#volverMenu" styleClass="ghost-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="10" right="24" bottom="24" left="24"/>
            </padding>
            <HBox spacing="16.0">
                <VBox spacing="6.0" prefWidth="220" styleClass="card mini-stat">
                    <Label fx:id="lblTotalMascotas" text="0" styleClass="stat-number"/>
                    <Label text="Registros guardados" styleClass="subtle-text"/>
                </VBox>
                <VBox spacing="6.0" prefWidth="220" styleClass="card mini-stat">
                    <Label fx:id="lblAdopcion" text="0" styleClass="stat-number"/>
                    <Label text="Mascotas en adopcion" styleClass="subtle-text"/>
                </VBox>
                <VBox spacing="6.0" prefWidth="220" styleClass="card mini-stat">
                    <Label fx:id="lblPerdidas" text="0" styleClass="stat-number"/>
                    <Label text="Mascotas perdidas" styleClass="subtle-text"/>
                </VBox>
            </HBox>
            <VBox spacing="12.0" styleClass="card result-card">
                <Label text="Registros consultados" styleClass="title-lg"/>
                <VBox spacing="10.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <CheckBox fx:id="chkSoloMisMascotas"
                                  text="Ver solo mis mascotas"
                                  onAction="#recargarMascotas"/>
                        <Button text="Actualizar lista"
                                onAction="#recargarMascotas"
                                styleClass="ghost-button"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Nuevo estado" styleClass="field-label"/>
                        <ComboBox fx:id="cbNuevoEstado" promptText="Seleccione estado" prefWidth="220"/>
                        <Button text="Cambiar estado"
                                onAction="#cambiarEstadoMascota"
                                styleClass="secondary-button"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Pasar a casa cuna" styleClass="field-label"/>
                        <ComboBox fx:id="cbCasaCuna" promptText="Seleccione casa cuna" prefWidth="260"/>
                        <Button text="Transferir control"
                                onAction="#pasarControlCasaCuna"
                                styleClass="secondary-button"/>
                    </HBox>
                    <Label text="El cambio de estado y la transferencia solo los puede hacer quien controla la publicacion o un admin."
                           wrapText="true"
                           styleClass="subtle-text"/>
                </VBox>
                <TableView fx:id="tablaMascotas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="160"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130"/>
                        <TableColumn fx:id="colRaza" text="Raza" prefWidth="180"/>
                        <TableColumn fx:id="colColor" text="Color" prefWidth="130"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="180"/>
                    </columns>
                </TableView>
                <Label fx:id="lblMensaje" text="" wrapText="true" styleClass="message-label"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
