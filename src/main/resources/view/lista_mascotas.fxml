<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.tec.bd.crv.controller.ListaMascotasController"
            styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="10" left="24"/>
            </padding>
            <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="2.0">
                <Label text="Pet list" styleClass="brand-title"/>
                <Label text="General pet list" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="New record" onAction="#abrirRegistro" styleClass="secondary-button"/>
            <Button text="Back to menu" onAction="#volverMenu" styleClass="ghost-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="10" right="24" bottom="24" left="24"/>
            </padding>
            <HBox spacing="16.0">
                <VBox spacing="6.0" prefWidth="220" styleClass="card mini-stat">
                    <Label fx:id="lblTotalMascotas" text="0" styleClass="stat-number"/>
                    <Label text="Saved records" styleClass="subtle-text"/>
                </VBox>
                <VBox spacing="6.0" prefWidth="220" styleClass="card mini-stat">
                    <Label fx:id="lblAdopcion" text="0" styleClass="stat-number"/>
                    <Label text="Pets for adoption" styleClass="subtle-text"/>
                </VBox>
                <VBox spacing="6.0" prefWidth="220" styleClass="card mini-stat">
                    <Label fx:id="lblPerdidas" text="0" styleClass="stat-number"/>
                    <Label text="Lost pets" styleClass="subtle-text"/>
                </VBox>
            </HBox>
            <VBox spacing="12.0" styleClass="card result-card">
                <Label text="Loaded records" styleClass="title-lg"/>
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <VBox spacing="6.0">
                        <Label text="Before" styleClass="field-label"/>
                        <ImageView fx:id="imgPetBeforePreview"
                                   fitHeight="120"
                                   fitWidth="180"
                                   preserveRatio="true"
                                   styleClass="photo-preview"/>
                    </VBox>
                    <VBox spacing="6.0">
                        <Label text="After" styleClass="field-label"/>
                        <ImageView fx:id="imgPetAfterPreview"
                                   fitHeight="120"
                                   fitWidth="180"
                                   preserveRatio="true"
                                   styleClass="photo-preview"/>
                    </VBox>
                    <VBox spacing="6.0">
                        <Label text="Selected pet photo" styleClass="section-title"/>
                        <Label fx:id="lblPhotoStatus"
                               text="Select a pet to preview its stored photos."
                               wrapText="true"
                               styleClass="subtle-text"/>
                    </VBox>
                </HBox>
                <VBox spacing="10.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <CheckBox fx:id="chkSoloMisMascotas"
                                  text="Show only my pets"
                                  onAction="#recargarMascotas"/>
                        <Button text="Refresh list"
                                onAction="#recargarMascotas"
                                styleClass="ghost-button"/>
                        <Button text="Edit selected"
                                onAction="#editarMascotaSeleccionada"
                                styleClass="secondary-button"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="New status" styleClass="field-label"/>
                        <ComboBox fx:id="cbNuevoEstado" promptText="Select status" prefWidth="220"/>
                        <Button text="Change status"
                                onAction="#cambiarEstadoMascota"
                                styleClass="primary-button"/>
                    </HBox>
                    <VBox spacing="8.0">
                        <CheckBox fx:id="chkTransferirCasaCuna"
                                  text="Optional: transfer control to a foster home"
                                  onAction="#configurarTransferenciaCasaCuna"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Foster home" styleClass="field-label"/>
                            <ComboBox fx:id="cbCasaCuna" promptText="Select foster home" prefWidth="260"/>
                            <Button fx:id="btnTransferirControl"
                                    text="Transfer control"
                                onAction="#pasarControlCasaCuna"
                                styleClass="secondary-button"/>
                        </HBox>
                    </VBox>
                    <Label text="Changing status does not require a foster home. Transfer is optional and only moves publication control."
                           wrapText="true"
                           styleClass="subtle-text"/>
                </VBox>
                <TableView fx:id="tablaMascotas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="colNombre" text="Name" prefWidth="160"/>
                        <TableColumn fx:id="colTipo" text="Type" prefWidth="130"/>
                        <TableColumn fx:id="colRaza" text="Breed" prefWidth="180"/>
                        <TableColumn fx:id="colColor" text="Color" prefWidth="130"/>
                        <TableColumn fx:id="colEstado" text="Status" prefWidth="180"/>
                        <TableColumn fx:id="colEdad" text="Age" prefWidth="90"/>
                    </columns>
                </TableView>
                <Label fx:id="lblMensaje" text="" wrapText="true" styleClass="message-label"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
