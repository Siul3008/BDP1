<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.tec.bd.crv.controller.AssociationController"
            styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="10" left="24"/>
            </padding>
            <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="2.0">
                <Label text="Associations" styleClass="brand-title"/>
                <Label text="Administrative organization management" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to admin panel" onAction="#volverAdmin" styleClass="ghost-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="10" right="24" bottom="24" left="24"/>
            </padding>
            <HBox spacing="18.0">
                <VBox spacing="12.0" prefWidth="420" styleClass="card form-card">
                    <Label text="Association data" styleClass="title-lg"/>
                    <GridPane hgap="14.0" vgap="14.0">
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Name" styleClass="field-label"/>
                            <TextField fx:id="txtNombreAsociacion" promptText="Association name"/>
                        </VBox>
                    </GridPane>
                    <HBox spacing="10.0">
                        <Button text="Save new" onAction="#guardarAsociacion" styleClass="primary-button">
                            <tooltip>
                                <Tooltip text="Registers a new association."/>
                            </tooltip>
                        </Button>
                        <Button text="Update name" onAction="#actualizarAsociacion" styleClass="secondary-button">
                            <tooltip>
                                <Tooltip text="Updates the selected association."/>
                            </tooltip>
                        </Button>
                    </HBox>
                    <HBox spacing="10.0">
                        <Button text="Clear" onAction="#limpiarFormulario" styleClass="ghost-button"/>
                        <Button text="Reload" onAction="#recargarAsociaciones" styleClass="ghost-button"/>
                    </HBox>
                    <Label fx:id="lblMensajeAsociacion" text="" wrapText="true" styleClass="message-label"/>
                </VBox>
                <VBox spacing="12.0" HBox.hgrow="ALWAYS" styleClass="card result-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Registered associations" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblResumenAsociaciones" text="0 association(s)" styleClass="message-label"/>
                    </HBox>
                    <TableView fx:id="tablaAsociaciones" prefHeight="420">
                        <columns>
                            <TableColumn fx:id="colAsociacionId" text="ID" prefWidth="70"/>
                            <TableColumn fx:id="colAsociacionNombre" text="Name" prefWidth="260"/>
                            <TableColumn fx:id="colAsociacionDonaciones" text="Donations" prefWidth="120"/>
                            <TableColumn fx:id="colAsociacionTotal" text="Total donated" prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
