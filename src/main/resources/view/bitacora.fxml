<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.tec.bd.crv.controller.AuditController"
            styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="10" left="24"/>
            </padding>
            <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="2.0">
                <Label text="Audit log" styleClass="brand-title"/>
                <Label text="Audit review and registered changes" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to menu" onAction="#volverMenu" styleClass="ghost-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="10" right="24" bottom="24" left="24"/>
            </padding>
            <VBox spacing="12.0" styleClass="card form-card">
                <Label text="Audit filters" styleClass="title-lg"/>
                <GridPane hgap="14.0" vgap="14.0">
                    <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Module" styleClass="field-label"/>
                        <TextField fx:id="txtModuloBitacora" promptText="Pets, donations, adoptions"/>
                    </VBox>
                    <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="User" styleClass="field-label"/>
                        <TextField fx:id="txtUsuarioBitacora" promptText="Email or profile"/>
                    </VBox>
                    <VBox spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Field" styleClass="field-label"/>
                        <TextField fx:id="txtCampoBitacora" promptText="Affected field"/>
                    </VBox>
                </GridPane>
                <HBox spacing="10.0">
                    <Button text="Search changes" onAction="#consultarBitacora" styleClass="primary-button">
                        <tooltip>
                            <Tooltip text="Reviews available audit changes."/>
                        </tooltip>
                    </Button>
                    <Button text="Clear filters" onAction="#limpiarBitacora" styleClass="secondary-button"/>
                </HBox>
                <Label fx:id="lblMensajeBitacora" text="" wrapText="true" styleClass="message-label"/>
            </VBox>
            <VBox spacing="12.0" styleClass="card result-card">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Audit records" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblResumenBitacora" text="0 record(s)" styleClass="message-label"/>
                </HBox>
                <TableView fx:id="tablaBitacora" prefHeight="430">
                    <columns>
                        <TableColumn fx:id="colFechaBitacora" text="Date" prefWidth="120"/>
                        <TableColumn fx:id="colModuloBitacora" text="Module" prefWidth="150"/>
                        <TableColumn fx:id="colUsuarioBitacora" text="User" prefWidth="130"/>
                        <TableColumn fx:id="colCampoBitacora" text="Field" prefWidth="180"/>
                        <TableColumn fx:id="colAnteriorBitacora" text="Previous value" prefWidth="190"/>
                        <TableColumn fx:id="colNuevoBitacora" text="New value" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
