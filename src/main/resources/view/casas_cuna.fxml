<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.tec.bd.crv.controller.CasaCunaController"
            styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="10" left="24"/>
            </padding>
            <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="2.0">
                <Label text="Casa cuna" styleClass="brand-title"/>
                <Label text="Condiciones de alojamiento temporal" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Volver al menu" onAction="#volverMenu" styleClass="ghost-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="10" right="24" bottom="24" left="24"/>
            </padding>
            <HBox spacing="18.0">
                <VBox spacing="14.0" HBox.hgrow="ALWAYS" styleClass="card form-card">
                    <Label text="Configurar casa cuna" styleClass="title-lg"/>
                    <Label fx:id="lblEstadoCasaCuna"
                           text="Completa estas condiciones para activar casa cuna."
                           wrapText="true"
                           styleClass="subtle-text"/>
                    <GridPane hgap="16.0" vgap="14.0">
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Tipos aceptados" styleClass="field-label"/>
                            <ScrollPane fitToWidth="true" prefHeight="210" prefWidth="280" styleClass="check-scroll">
                                <content>
                                    <VBox fx:id="boxTiposAceptados" spacing="8.0" styleClass="check-list"/>
                                </content>
                            </ScrollPane>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Tamanos aceptados" styleClass="field-label"/>
                            <ScrollPane fitToWidth="true" prefHeight="210" prefWidth="280" styleClass="check-scroll">
                                <content>
                                    <VBox fx:id="boxTamanosAceptados" spacing="8.0" styleClass="check-list"/>
                                </content>
                            </ScrollPane>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Donacion de alimento" styleClass="field-label"/>
                            <ComboBox fx:id="cbDonacionAlimento"
                                      promptText="Seleccione una opcion"
                                      prefWidth="280"/>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                            <Label text="Notas adicionales" styleClass="field-label"/>
                            <TextArea fx:id="txtNotasCasaCuna"
                                      prefRowCount="4"
                                      wrapText="true"
                                      promptText="Ejemplo: horario, espacio disponible, restricciones o cuidados especiales."/>
                        </VBox>
                    </GridPane>
                    <HBox spacing="10.0">
                        <Button text="Guardar casa cuna"
                                onAction="#guardarCasaCuna"
                                styleClass="primary-button">
                            <tooltip>
                                <Tooltip text="Guarda las condiciones y activa el perfil como casa cuna."/>
                            </tooltip>
                        </Button>
                    </HBox>
                    <Label fx:id="lblMensajeCasaCuna" text="" wrapText="true" styleClass="message-label"/>
                </VBox>
                <VBox spacing="12.0" prefWidth="360" styleClass="card result-card">
                    <Label text="Como usar esta pantalla" styleClass="section-title"/>
                    <Label text="Marca todas las opciones que aplican. Puedes activar o quitar cada una con un clic."
                           wrapText="true"
                           styleClass="subtle-text"/>
                    <Label text="Estas condiciones se guardan en las tablas de casa cuna y se pueden editar entrando de nuevo a este modulo."
                           wrapText="true"
                           styleClass="subtle-text"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
