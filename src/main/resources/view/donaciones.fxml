<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.tec.bd.crv.controller.DonationController"
            styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="10" left="24"/>
            </padding>
            <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="2.0">
                <Label text="Donations" styleClass="brand-title"/>
                <Label text="Donation entry and administrative search" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to menu" onAction="#volverMenu" styleClass="ghost-button">
                <tooltip>
                    <Tooltip text="Returns to the active account menu."/>
                </tooltip>
            </Button>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="10" right="24" bottom="24" left="24"/>
            </padding>
            <HBox spacing="18.0">
                <VBox fx:id="pnlRegistroDonacion" spacing="12.0" prefWidth="410" styleClass="card form-card">
                    <Label text="New donation" styleClass="title-lg"/>
                    <Label fx:id="lblModoDonacion" text="" wrapText="true" styleClass="subtle-text"/>
                    <GridPane hgap="14.0" vgap="14.0">
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                            <Label text="Beneficiary association" styleClass="field-label"/>
                            <ComboBox fx:id="cbAsociacionDonacion" promptText="Select association" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Currency" styleClass="field-label"/>
                            <ComboBox fx:id="cbMonedaDonacion" promptText="CRC / USD"/>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Amount" styleClass="field-label"/>
                            <TextField fx:id="txtMontoDonacion" promptText="0.00"/>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                            <Label text="Donation date" styleClass="field-label"/>
                            <DatePicker fx:id="dpFechaDonacion"/>
                        </VBox>
                    </GridPane>
                    <HBox spacing="10.0">
                        <Button fx:id="btnRegistrarDonacion" text="Register donation" onAction="#registrarDonacion" styleClass="primary-button">
                            <tooltip>
                                <Tooltip text="Saves the donation and links it to your user."/>
                            </tooltip>
                        </Button>
                        <Button text="Clear" onAction="#limpiarFormularioDonacion" styleClass="secondary-button">
                            <tooltip>
                                <Tooltip text="Clears the donation form fields."/>
                            </tooltip>
                        </Button>
                    </HBox>
                    <Label text="The distribution is recorded as 100% for the selected association." wrapText="true" styleClass="subtle-text"/>
                </VBox>
                <VBox spacing="12.0" HBox.hgrow="ALWAYS" styleClass="card form-card">
                    <Label text="Donation search" styleClass="title-lg"/>
                    <GridPane hgap="14.0" vgap="14.0">
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="From" styleClass="field-label"/>
                            <DatePicker fx:id="dpDesdeFiltro"/>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="To" styleClass="field-label"/>
                            <DatePicker fx:id="dpHastaFiltro"/>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Donor" styleClass="field-label"/>
                            <TextField fx:id="txtDonadorFiltro" promptText="Name or last name"/>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <Label text="Association" styleClass="field-label"/>
                            <ComboBox fx:id="cbFiltroAsociacion" promptText="All"/>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="4" GridPane.rowIndex="0">
                            <Label text="Exact amount" styleClass="field-label"/>
                            <TextField fx:id="txtMontoFiltro" promptText="0.00"/>
                        </VBox>
                    </GridPane>
                    <HBox spacing="10.0">
                        <Button text="Search" onAction="#buscarDonaciones" styleClass="primary-button">
                            <tooltip>
                                <Tooltip text="Searches donations by date range, donor, or association."/>
                            </tooltip>
                        </Button>
                        <Button text="Clear filters" onAction="#limpiarFiltros" styleClass="secondary-button"/>
                        <Button fx:id="btnEliminarDonacion" text="Delete selected" onAction="#eliminarDonacionSeleccionada" styleClass="danger-button">
                            <tooltip>
                                <Tooltip text="Admin only: deletes the selected donation."/>
                            </tooltip>
                        </Button>
                    </HBox>
                    <Label fx:id="lblResumenDonaciones" text="0 records" wrapText="true" styleClass="section-title"/>
                </VBox>
            </HBox>
            <VBox spacing="12.0" styleClass="card result-card">
                <Label text="Results" styleClass="section-title"/>
                <TableView fx:id="tablaDonaciones" prefHeight="330">
                    <columns>
                        <TableColumn fx:id="colDonador" text="Donor" prefWidth="220"/>
                        <TableColumn fx:id="colAsociacion" text="Association" prefWidth="230"/>
                        <TableColumn fx:id="colMonto" text="Amount" prefWidth="140"/>
                        <TableColumn fx:id="colFecha" text="Date" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
            <Label fx:id="lblMensajeDonacion" text="" wrapText="true" styleClass="message-label"/>
        </VBox>
    </center>
</BorderPane>
