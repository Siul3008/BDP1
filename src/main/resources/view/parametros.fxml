<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.tec.bd.crv.controller.ParameterController"
            styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="10" left="24"/>
            </padding>
            <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="2.0">
                <Label text="Parametros" styleClass="brand-title"/>
                <Label text="Mantenimiento de catalogos administrables" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Volver al menu" onAction="#backToMenu" styleClass="ghost-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="10" right="24" bottom="24" left="24"/>
            </padding>
            <VBox spacing="12.0" styleClass="card form-card">
                <Label text="Catalogo a administrar" styleClass="title-lg"/>
                <GridPane hgap="14.0" vgap="14.0">
                    <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Categoria" styleClass="field-label"/>
                        <ComboBox fx:id="cbCategory" promptText="Seleccione categoria" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label fx:id="lblName" text="Nombre" styleClass="field-label"/>
                        <TextField fx:id="txtName" promptText="Nombre del registro"/>
                    </VBox>
                    <VBox fx:id="boxPetType" spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Tipo de mascota" styleClass="field-label"/>
                        <ComboBox fx:id="cbPetType" promptText="Tipo relacionado"/>
                    </VBox>
                    <VBox fx:id="boxExtra" spacing="6.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label fx:id="lblExtra" text="Valor" styleClass="field-label"/>
                        <TextField fx:id="txtExtra" promptText="Valor adicional"/>
                    </VBox>
                    <VBox fx:id="boxDescription" spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="4">
                        <Label text="Descripcion" styleClass="field-label"/>
                        <TextArea fx:id="txtDescription" prefRowCount="2" promptText="Descripcion del parametro"/>
                    </VBox>
                </GridPane>
                <HBox spacing="10.0">
                    <Button text="Guardar" onAction="#saveParameter" styleClass="primary-button">
                        <tooltip>
                            <Tooltip text="Crea o actualiza el registro seleccionado."/>
                        </tooltip>
                    </Button>
                    <Button text="Nuevo" onAction="#newParameter" styleClass="secondary-button"/>
                    <Button text="Actualizar lista" onAction="#loadRecords" styleClass="ghost-button"/>
                </HBox>
                <Label fx:id="lblMessage" text="" wrapText="true" styleClass="message-label"/>
            </VBox>
            <VBox spacing="12.0" styleClass="card result-card">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Registros del catalogo" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSummary" text="0 registro(s)" styleClass="message-label"/>
                </HBox>
                <TableView fx:id="tableParameters" prefHeight="390">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="90"/>
                        <TableColumn fx:id="colName" text="Nombre" prefWidth="330"/>
                        <TableColumn fx:id="colExtra" text="Detalle" prefWidth="360"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
