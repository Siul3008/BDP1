<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.tec.bd.crv.controller.ParameterController"
            styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="10" left="24"/>
            </padding>
            <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <VBox spacing="2.0">
                <Label text="Parameters" styleClass="brand-title"/>
                <Label text="Manageable catalog maintenance" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to menu" onAction="#backToMenu" styleClass="ghost-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="10" right="24" bottom="24" left="24"/>
            </padding>
            <VBox spacing="12.0" styleClass="card form-card">
                <Label text="Catalog to manage" styleClass="title-lg"/>
                <GridPane hgap="14.0" vgap="14.0">
                    <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Category" styleClass="field-label"/>
                        <ComboBox fx:id="cbCategory" promptText="Select category" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label fx:id="lblName" text="Name" styleClass="field-label"/>
                        <TextField fx:id="txtName" promptText="Record name"/>
                    </VBox>
                    <VBox fx:id="boxPetType" spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Pet type" styleClass="field-label"/>
                        <ComboBox fx:id="cbPetType" promptText="Related type"/>
                    </VBox>
                    <VBox fx:id="boxExtra" spacing="6.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label fx:id="lblExtra" text="Value" styleClass="field-label"/>
                        <TextField fx:id="txtExtra" promptText="Additional value"/>
                    </VBox>
                    <VBox fx:id="boxDescription" spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="4">
                        <Label text="Description" styleClass="field-label"/>
                        <TextArea fx:id="txtDescription" prefRowCount="2" promptText="Parameter description"/>
                    </VBox>
                </GridPane>
                <HBox spacing="10.0">
                    <Button text="Save" onAction="#saveParameter" styleClass="primary-button">
                        <tooltip>
                            <Tooltip text="Creates or updates the selected record."/>
                        </tooltip>
                    </Button>
                    <Button text="New" onAction="#newParameter" styleClass="secondary-button"/>
                    <Button text="Refresh list" onAction="#loadRecords" styleClass="ghost-button"/>
                </HBox>
                <Label fx:id="lblMessage" text="" wrapText="true" styleClass="message-label"/>
            </VBox>
            <VBox spacing="12.0" styleClass="card result-card">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Catalog records" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSummary" text="0 record(s)" styleClass="message-label"/>
                </HBox>
                <TableView fx:id="tableParameters" prefHeight="390">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="90"/>
                        <TableColumn fx:id="colName" text="Name" prefWidth="330"/>
                        <TableColumn fx:id="colExtra" text="Detail" prefWidth="360"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
